{
  "name": "j2grows",
  "private": true,
  "version": "0.1.0",
  "description": "J2Grows - botanical genetics, breeding and laboratory management simulator. Grow. Discover. Experiment. Evolve.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "balance": "tsx scripts/balance-sim.ts",
    "build:bun": "bun scripts/build-bun.ts",
    "e2e": "bun scripts/build-bun.ts && node scripts/e2e.cjs",
    "shoot": "node scripts/shoot.cjs shots"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.50.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
